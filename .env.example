# Copie para .env e preencha. Só estas duas linhas são necessárias —
# caixa monitorada, remetentes permitidos e o resto já vêm no código
# (src/config.js) e podem ser sobrescritos aqui se precisar.

# Webhook de ENTRADA do Bitrix (Aplicativos > Recursos para desenvolvedores).
BITRIX_WEBHOOK=https://crm.topsolidbrazil.com/rest/1/SEU_TOKEN

# Token que o Bitrix mostra ao criar o webhook de SAÍDA.
# Sem ele, o endpoint /topSolid aceita requisição de qualquer origem.
BITRIX_APPLICATION_TOKEN=

# Quando estiver confiante no log, ligue a exclusão de lead cujo assunto
# não é de formulário conhecido:
# BITRIX_EXCLUIR_LEAD_DESCONHECIDO=true
